{
  "id": "netease",
  "name": "网易云音乐",
  "version": "0.3.4",
  "minAppVersion": "0.1.21",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["*"]
  },
  "settings": [
    {
      "key": "externalSourceEnabled",
      "label": "使用外部音源",
      "type": "boolean",
      "help": "开启后先向 LX 音源取直链，拿不到合规直链时自动回落官方播放；关闭时不发出任何音源请求。"
    },
    {
      "key": "externalSourceScript",
      "label": "LX 音源脚本地址",
      "help": "填完整的 LX 脚本地址，必须以 https:// 开头，例如 https://source.shiqianjiang.cn/api/script/lx?key=…。只读取脚本声明的接口，不执行脚本。"
    }
  ],
  "navigation": [
    { "title": "发现音乐", "builtin": "home" },
    { "title": "私人漫游", "builtin": "stations" },
    { "title": "排行榜", "page": "charts", "icon": "chart" },
    { "title": "我喜欢的音乐", "builtin": "liked" },
    { "title": "我收藏的专辑", "builtin": "savedAlbums" },
    { "title": "我的播客", "builtin": "shows" }
  ]
}
